# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

GROQ_API_KEY=your-groq-api-key-here

# Optional — only needed if you want LangSmith tracing of LLM calls.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=muj-regs-rag

# Redis is used both as the LLM response cache and the API's rate-limit counter.
REDIS_URL=redis://localhost:6379/1
